<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/estilo.css">
    <title>Meus pontos | Eco Acolhe</title>
</head>
<body>

    <main>
        <%- include('../partials/headerCliente') %>

        <section class="meus-pontos">
            <h1>Meus pontos</h1>
